# --- AI Growth Kit environment configuration ---
# Copy to .env (gitignored) and fill in. NEVER commit real secrets.

# Database — PostgreSQL (Neon in production).
# DATABASE_URL: pooled connection (…-pooler…) used by the app at runtime.
# DIRECT_URL:   direct connection used by prisma migrate. If you are not using
#               Neon's pooler, DIRECT_URL can be the same as DATABASE_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"

# OpenAI — server-side only, never exposed to the browser.
OPENAI_API_KEY=""

# Auth.js session/JWT secret. Generate: openssl rand -base64 33
AUTH_SECRET=""

# Public base URL used to build tracking links (no trailing slash).
# Production: https://your-domain
APP_BASE_URL="http://localhost:3000"

# Discord Owned Publisher — an incoming webhook URL for the customer's channel.
DISCORD_WEBHOOK_URL=""

# Reddit DISCOVER (official API). Pending approval — leave blank to keep the
# provider gracefully disabled (approval_pending). No fake data is used.
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_REDIRECT_URI="http://localhost:3000/api/auth/callback/reddit"

# Google Play import via the official DataForSEO App Data API (server-side only).
# Leave blank to disable Google Play import (manual onboarding still works).
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# Google Ads integration (server-side only; customer authorizes via Google OAuth).
# Leave blank to keep the integration visibly "not configured" — it fails safe.
# GOOGLE_ADS_TOKEN_ENCRYPTION_KEY protects the stored refresh token (AES-256-GCM).
# Generate one with: openssl rand -base64 32
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_TOKEN_ENCRYPTION_KEY=""
# Only needed when authorizing through a Google Ads manager account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""
